[0.768, "o", "\u001b[2m01:27\u001b[0m    \u001b[36m\u21b3 inbox\u001b[0m \u001b[2m1 open: FR has cut MAH-EMA fares by 20%\u001b[0m\r\n"]
[2.0, "o", "\u001b[2m01:32\u001b[0m  \u001b[97mA pricing decision: Ryanair cut MAH-EMA fares by 20%. Our Menorca flights are already selling well,\u001b[0m\r\n\u001b[2m01:32\u001b[0m  \u001b[97mso I'll hold rather than give away revenue on seats that will fill anyway.\u001b[0m\r\n"]
[0.757, "o", "\u001b[2m01:33\u001b[0m  \u001b[33m\u25b6 decide\u001b[0m\u001b[2m(id=d000007, option=hold)\u001b[0m\r\n"]
[0.579, "o", "\u001b[2m01:33\u001b[0m    \u001b[36m\u21b3 decide\u001b[0m \u001b[2mdecided\u001b[0m\r\n"]
[1.663, "o", "\u001b[2m01:35\u001b[0m  \u001b[32m\u270e note\u001b[0m \u001b[32mFR cut MAH-EMA by 20% and asked whether we match. Our Menorca flights are booking in the high 70s to 80s percent of the cabin already, so a 20% cut would mostly discount seats that sell anyway. Held the fare; if MAH loads sag later I can revisit with a targeted sale.\u001b[0m\r\n"]
